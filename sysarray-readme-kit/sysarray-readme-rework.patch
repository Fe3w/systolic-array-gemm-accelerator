index 422eb94..189817c 100644
--- a/docs/waveforms/README.md
+++ b/docs/waveforms/README.md
@@ -1,7 +1,90 @@
-# docs/waveforms/
+# Waveforms: see the array work
+
+Three ways to watch the hardware work, from easiest to most detailed. All of
+them start from a real simulation of the RTL; nothing is drawn by hand.
+Back to the [README](../../README.md).
 
 Waveform pictures of one full S = 4 tile (weight load, compute, drain) live in
 `docs/img/`: `waves_tile_s4.png` (GTKWave, `make waves-png`), `tile_s4.png`
 (signal traces, `scripts/waves/plot_tile.py`) and `tile_s4.gif` (animation,
 `make animate`). Raw VCD/FST files are not committed; `make demo-waves`
 regenerates the VCD.
+
+**1. The animation (no tools needed).** The GIF at the top of the README.
+Regenerate it from a fresh simulation:
+
+```bash
+make animate      # simulate one S = 4 tile, then write docs/img/tile_s4.gif (seconds once the simulator is built)
+```
+
+How to read a frame: each box is one processing element (PE). `w` is the
+weight it holds (stationary), `a` the activation passing through it (moves
+right, highlighted while valid), `Σ` the partial sum it passes down (one cycle
+after `a`, because multiply and add are two pipeline stages). On the left, the
+value entering each row after the skew (row r is r cycles late); at the
+bottom, the finished row of C after the de-skew, 2S = 8 cycles after its row
+of A went in.
+
+**2. The waveform in GTKWave (one tile, saved layout).** Needs
+`sudo apt install gtkwave`.
+
+```bash
+make demo-waves   # simulate one S = 4 tile with waves on, open it in GTKWave
+```
+
+This writes `build/demo/tile_s4.vcd` and opens it with the layout
+`docs/demo/tile_s4.gtkw`, four signal groups top to bottom
+(screenshot of that view; regenerate with `make waves-png`):
+
+![GTKWave: one S = 4 tile](../img/waves_tile_s4.png)
+
+
+| Group | Signals | What to look for |
+| --- | --- | --- |
+| Weight load | `w_load`, `w_row`, weights of column 0 | one row of B shifts in per cycle while `w_load` is high |
+| Activations | `a_row`, `grid_a_valid`, `a_q` of column 0 | each row of the array sees A one cycle after the row above (the skew) |
+| Partial sums | `psum_q` down column 0 | the sum grows by one product per PE, one PE per cycle |
+| Outputs | `grid_valid`, `c_valid`, `c_row` | the de-skewed row of C leaves all at once |
+
+Markers sit at the first `w_load` (15 ns) and the first `c_valid` (130 ns).
+In this first tile the weights are the identity (`w_q[0][0]` = 1, the rest of
+column 0 is 0), so column 0 of C equals column 0 of A: the values −125, −128,
+127 enter `a_q[0][0]` and pass unchanged down `psum_q[r][0]`, one PE per cycle.
+The columns leave the grid skewed (`grid_valid` 0001 → 0011 → 0111 → 1110 →
+1100 → 1000 for the three rows of A), and after the de-skew `c_valid` is high
+for three cycles, one whole row of C per cycle.
+Without a desktop (or to open it again later):
+
+```bash
+make demo-waves && gtkwave build/demo/tile_s4.vcd docs/demo/tile_s4.gtkw
+```
+
+**3. Waveforms of any test.** Every cocotb testbench dumps a VCD when
+`SYSARRAY_WAVES=1`:
+
+```bash
+SYSARRAY_WAVES=1 make test-rtl        # all blocks (a few minutes)
+```
+```bash
+SYSARRAY_WAVES=1 SYSARRAY_SEED=5 python3 -m pytest -q "tb/array/test_array.py::test_sa_array[4-False]"   # one test
+```
+```bash
+find tb -name dump.vcd                # where the waveforms are (one per build directory)
+```
+
+Open one with `gtkwave <path>/dump.vcd`. GTKWave basics: expand the hierarchy
+in the top-left pane (SST), select signals and click **Append** (or drag them
+into the Signals pane); **Zoom Fit** (Ctrl+Alt+F) shows the whole run; right-
+click a bus → **Data Format** → **Signed Decimal** to read int8/int32 values;
+click in the wave area to place the cursor and read every value at that time;
+**File → Write Save File** keeps your layout. For a text view instead,
+`python3 scripts/waves/vcd_cycle_table.py <vcd> <n>` prints the cycle table of
+the n-th isolated row from an `sa_array` VCD.
+
+## The same tile, as signal traces
+
+![one tile at S = 4](../img/tile_s4.png)
+
+`scripts/waves/plot_tile.py` draws this from the simulation's VCD. For the
+dataflow picture with the cycle at which each PE multiplies each row, see
+[ARCHITECTURE.md](../ARCHITECTURE.md).
diff --git a/scripts/report/readme_figures.py b/scripts/report/readme_figures.py
new file mode 100644
index 0000000..6dd21e5
--- /dev/null
+++ b/scripts/report/readme_figures.py
@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+"""README figures (portfolio README rework).
+
+  docs/img/flow.png                     how a GEMM goes through the stack: tiling
+                                        compiler -> command stream -> RTL, with the
+                                        two checks (NumPy, performance model)
+  docs/img/utilization_before_after.png PE utilization per GEMM shape, MVP vs
+                                        double buffering, read from results/perf/
+
+Every number in the second figure is read from the two perf CSVs (measured RTL
+counters); nothing is typed in by hand. For each shape the first order-A row of
+each file is used, the same rows as the README table.
+Usage (repo root):
+    python3 scripts/report/readme_figures.py [--out docs/img]
+        [--mvp results/perf/f5c0a0c.csv] [--final results/perf/be6f466.csv]
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import sys
+from pathlib import Path
+
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt  # noqa: E402
+from matplotlib.patches import FancyArrowPatch, FancyBboxPatch  # noqa: E402
+
+REPO = Path(__file__).resolve().parents[2]
+INK, MUTED, ACCENT, FILL, FILL2 = "#1f2933", "#52606d", "#0b6e8a", "#e3f0f4", "#f5f7fa"
+MVP_C, FINAL_C = "#9aa5b1", "#0b6e8a"
+# Shapes shown, in this order (the large, realistic ones plus one odd shape).
+SHAPES = ["sq256", "bert_proj", "bert_ffn_down", "bert_ffn_up", "r50_3x3", "r50_1x1", "odd"]
+
+
+def _box(ax, x, y, w, h, title, sub="", fill=FILL):
+    ax.add_patch(FancyBboxPatch((x, y), w, h, boxstyle="round,pad=0.02,rounding_size=0.08",
+                                fc=fill, ec=INK, lw=1.2))  # fmt: skip
+    if sub:
+        ax.text(x + w / 2, y + h * 0.64, title, ha="center", va="center", fontsize=11,
+                color=INK, weight="bold")  # fmt: skip
+        ax.text(x + w / 2, y + h * 0.30, sub, ha="center", va="center", fontsize=8.6,
+                color=MUTED, linespacing=1.35)  # fmt: skip
+    else:
+        ax.text(x + w / 2, y + h / 2, title, ha="center", va="center", fontsize=11,
+                color=INK, weight="bold")  # fmt: skip
+
+
+def _arrow(ax, x0, y0, x1, y1, text="", color=INK, dy=0.13):
+    ax.add_patch(FancyArrowPatch((x0, y0), (x1, y1), arrowstyle="-|>", mutation_scale=13,
+                                 lw=1.3, color=color))  # fmt: skip
+    if text:
+        ax.text((x0 + x1) / 2, (y0 + y1) / 2 + dy, text, ha="center", va="bottom",
+                fontsize=8.5, color=color)  # fmt: skip
+
+
+def flow(out: Path) -> Path:
+    fig, ax = plt.subplots(figsize=(12.9, 4.4))
+    ax.set_xlim(0, 12.9)
+    ax.set_ylim(-0.1, 4.3)
+    ax.axis("off")
+    h, top, bot = 1.15, 2.85, 0.6
+    gemm, comp, rtl, res = (0.2, 2.1), (3.0, 2.4), (6.6, 3.3), (10.7, 2.0)
+    _box(ax, *gemm[:1], top, gemm[1], h, "GEMM", "C = A · B\nM × N × K, int8", fill=FILL2)
+    _box(ax, comp[0], top, comp[1], h, "Tiling compiler",
+         "Python: tiles, tile order,\npadding, buffer halves")  # fmt: skip
+    _box(ax, rtl[0], top, rtl[1], h, "SysArray RTL",
+         "SystemVerilog: 8 × 8 weight-stationary\narray, DMA, buffers, controller")  # fmt: skip
+    _box(ax, res[0], top, res[1], h, "Result", "C (int32) and\ncycle counters", fill=FILL2)
+    mid = top + h / 2
+    _arrow(ax, gemm[0] + gemm[1], mid, comp[0], mid, "shape")
+    _arrow(ax, comp[0] + comp[1], mid, rtl[0], mid, "commands", color=ACCENT)
+    ax.text((comp[0] + comp[1] + rtl[0]) / 2, mid - 0.12, "LOAD_W\nLOAD_A\nCOMPUTE\nSTORE",
+            fontsize=7.4, color=ACCENT, ha="center", va="top", linespacing=1.25)  # fmt: skip
+    _arrow(ax, rtl[0] + rtl[1], mid, res[0], mid)
+
+    chk = (10.2, 2.5)
+    _box(ax, gemm[0], bot, gemm[1], h, "Golden model", "NumPy, int32 wrap", fill=FILL2)
+    _box(ax, comp[0], bot, comp[1], h, "Performance model",
+         "predicts cycles from\nthe command stream", fill=FILL2)  # fmt: skip
+    _box(ax, chk[0], bot, chk[1], h, "Checks",
+         "C bit-exact vs NumPy\nmeasured = predicted cycles")  # fmt: skip
+    for x, w in (gemm, comp):
+        _arrow(ax, x + w / 2, top, x + w / 2, bot + h)
+    _arrow(ax, res[0] + res[1] / 2, top, res[0] + res[1] / 2, bot + h)
+    _arrow(ax, comp[0] + comp[1], bot + h / 2, chk[0], bot + h / 2, "predicted cycles",
+           color=MUTED, dy=0.06)  # fmt: skip
+    y = bot - 0.35
+    ax.plot([gemm[0] + gemm[1] / 2, gemm[0] + gemm[1] / 2], [bot, y], color=MUTED, lw=1.3)
+    ax.plot([gemm[0] + gemm[1] / 2, chk[0] + 0.5], [y, y], color=MUTED, lw=1.3)
+    _arrow(ax, chk[0] + 0.5, y, chk[0] + 0.5, bot, color=MUTED)
+    ax.text((comp[0] + comp[1] + chk[0]) / 2, y + 0.06, "expected C", ha="center",
+            va="bottom", fontsize=8.5, color=MUTED)  # fmt: skip
+    path = out / "flow.png"
+    fig.savefig(path, dpi=160, bbox_inches="tight", facecolor="white")
+    plt.close(fig)
+    return path
+
+
+def _first_order_a(csv_path: Path) -> dict[str, dict[str, str]]:
+    rows: dict[str, dict[str, str]] = {}
+    with csv_path.open() as f:
+        for r in csv.DictReader(f):
+            if r["order"] == "A" and r["shape_id"] not in rows:
+                rows[r["shape_id"]] = r
+    return rows
+
+
+def before_after(out: Path, mvp_csv: Path, final_csv: Path) -> Path:
+    mvp, final = _first_order_a(mvp_csv), _first_order_a(final_csv)
+    shapes = [s for s in SHAPES if s in mvp and s in final]
+    u0 = [float(mvp[s]["utilization"]) for s in shapes]
+    u1 = [float(final[s]["utilization"]) for s in shapes]
+    fig, ax = plt.subplots(figsize=(10.5, 4.2))
+    x = range(len(shapes))
+    bw = 0.38
+    b0 = ax.bar([i - bw / 2 for i in x], u0, bw, color=MVP_C, label="MVP (no overlap)")
+    b1 = ax.bar([i + bw / 2 for i in x], u1, bw, color=FINAL_C, label="double buffering")
+    for bars, vals in ((b0, u0), (b1, u1)):
+        for b, v in zip(bars, vals):
+            ax.text(b.get_x() + b.get_width() / 2, v + 0.015, f"{v:.2f}", ha="center",
+                    va="bottom", fontsize=8.5, color=INK)  # fmt: skip
+    labels = [f"{s}\n{final[s]['M']}×{final[s]['N']}×{final[s]['K']}" for s in shapes]
+    ax.set_xticks(list(x), labels, fontsize=8.5, color=INK)
+    ax.set_ylim(0, 1.0)
+    ax.set_ylabel("PE utilization (measured)", color=MUTED)
+    ax.set_title(f"SysArray S = {final[shapes[0]]['S']}: PE utilization, MVP vs double buffering"
+                 f" ({mvp_csv.name} → {final_csv.name})", color=INK, fontsize=11, loc="left")  # fmt: skip
+    ax.spines[["top", "right"]].set_visible(False)
+    ax.grid(axis="y", color="#e4e7eb")
+    ax.set_axisbelow(True)
+    ax.legend(frameon=False, loc="upper right", fontsize=9)
+    path = out / "utilization_before_after.png"
+    fig.savefig(path, dpi=160, bbox_inches="tight", facecolor="white")
+    plt.close(fig)
+    return path
+
+
+def main(argv: list[str] | None = None) -> int:
+    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    p.add_argument("--out", type=Path, default=REPO / "docs" / "img")
+    p.add_argument("--mvp", type=Path, default=REPO / "results" / "perf" / "f5c0a0c.csv")
+    p.add_argument("--final", type=Path, default=REPO / "results" / "perf" / "be6f466.csv")
+    a = p.parse_args(argv)
+    a.out.mkdir(parents=True, exist_ok=True)
+    for path in (flow(a.out), before_after(a.out, a.mvp, a.final)):
+        print(path)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/report/test_readme_figures.py b/scripts/report/test_readme_figures.py
new file mode 100644
index 0000000..e6a35ef
--- /dev/null
+++ b/scripts/report/test_readme_figures.py
@@ -0,0 +1,16 @@
+"""Smoke test: the README figures regenerate from their script and the committed CSVs."""
+
+from __future__ import annotations
+
+import subprocess
+import sys
+from pathlib import Path
+
+SCRIPT = Path(__file__).with_name("readme_figures.py")
+
+
+def test_readme_figures_regenerate(tmp_path: Path) -> None:
+    subprocess.run([sys.executable, str(SCRIPT), "--out", str(tmp_path)], check=True,
+                   capture_output=True)  # fmt: skip
+    for name in ("flow.png", "utilization_before_after.png"):
+        assert (tmp_path / name).stat().st_size > 10_000, name
